{
  "name": "hackku-website",
  "version": "1.27.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun run --env-file .env --bun next dev --webpack",
    "build": "bun run --env-file .env --bun next build",
    "generate": "bun run --env-file .env --bun prisma generate",
    "start": "bun run --env-file .env --bun next start",
    "biome": "bun run --env-file .env --bun biome check --write",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:seed": "bun run --env-file .env --bun prisma db seed",
    "db:dev": "bun run --env-file .env --bun prisma migrate dev",
    "db:migrate": "bun run --env-file .env --bun prisma migrate deploy",
    "db:studio": "bun run --env-file .env --bun prisma studio"
  },
